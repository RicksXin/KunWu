# ==============================================================================
# 《昆吾禁地》.gitignore
# 依据 Docs/01_技术实现方案.md §4、§17
# ==============================================================================

# ------------------------------------------------------------------------------
# Cocos Creator 生成目录（禁止提交）
# ------------------------------------------------------------------------------
# 资源导入缓存，由 assets/ + *.meta 重新生成
/library/
# 编辑器临时文件
/temp/
# 本机编辑器布局与个人偏好，因人而异
/local/
# 编辑器本机运行时配置（场景视图状态等），与 settings/ 不同，不应共享
/profiles/
# 构建输出（dist/web、native 产物等）
/build/
/dist/

# 注意：以下内容必须提交，不要加入忽略
#   assets/**/*.meta   资源 UUID 映射，丢失会导致全项目引用断裂
#   /settings/         项目级构建与引擎配置
#   /build-templates/  自定义 Web Shell 模板

# ------------------------------------------------------------------------------
# 原生封装（后续封装 Windows/Android 时启用）
# ------------------------------------------------------------------------------
# native/engine 属于工程配置需提交，仅忽略中间产物
/native/**/build/
/native/**/.cxx/
/native/**/*.keystore

# ------------------------------------------------------------------------------
# Node / 工具链
# ------------------------------------------------------------------------------
node_modules/
.npm/
.yarn/
*.tsbuildinfo
.eslintcache
coverage/
.nyc_output/

# 数据表构建产物：CSV/JSON 由构建脚本转为 TS 声明，源表提交、产物不提交
/assets/data/**/*.generated.ts
/assets/data/**/*.generated.json

# 数值总表 xlsx 是 assets/data/balance/*.json 的只读视图，由 pnpm balance:xlsx 生成。
# 不提交：二进制、无法 diff，且提交后必然与源表漂移，让人误当事实源。
/outputs/balance/

# ------------------------------------------------------------------------------
# 环境与密钥
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.p12
*.mobileprovision

# ------------------------------------------------------------------------------
# 操作系统
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Office 打开 outputs/ 下的 .xlsx 时会生成同名锁文件，别提交进去
~$*
*.xlsx#
.~lock.*#

# ------------------------------------------------------------------------------
# 编辑器与 AI 工具
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.claude/settings.local.json

# ------------------------------------------------------------------------------
# 美术与音频中间文件
# ------------------------------------------------------------------------------
# Aseprite/Photoshop 自动备份与恢复文件
*.aseprite-recover
*.psd.bak
*.tmp
# Tiled 会话状态，非地图数据
*.tiled-session
.playwright-mcp/

# 本工程用 pnpm，不应出现 npm/yarn 锁文件
package-lock.json
yarn.lock
